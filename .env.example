# Copy to .env and adjust as needed. Flask/uv don't auto-load this file;
# export these into your shell (or wire them into docker-compose.yaml) as needed.

# development | production
APP_ENV=development

# Required in production; dev has a built-in fallback.
SECRET_KEY=

# Defaults to sqlite:///products.db in development if unset.
# Required in production (e.g. postgresql://user:pass@host:5432/dbname).
FLASK_DB_URI=

FLASK_DEBUG=1

# Authentik SSO — leave all blank to disable SSO (app-managed login always works).
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Full callback URL registered with Authentik, e.g. https://cider.example.com/api/auth/sso/callback
AUTHENTIK_REDIRECT_URI=
# Authentik group name that's allowed to auto-provision a new account on first SSO login.
# Leave blank to require accounts to be created via `flask user create` first.
AUTHENTIK_AUTO_PROVISION_GROUP=
